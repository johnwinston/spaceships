// Spaceships claim service. Deploy steps: see README.md in this directory.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaceships-claims",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Browser origins allowed to call the API (the collection + player pages).
  "vars": {
    "ALLOWED_ORIGINS": "https://john-winston.com,http://localhost:8765,http://127.0.0.1:8765,http://localhost:8123,http://127.0.0.1:8123"
  },
  // Create with `wrangler kv namespace create CLAIMS` and paste the id here.
  "kv_namespaces": [
    { "binding": "CLAIMS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // Per-IP limit on the write endpoints (POST /claim, POST /admin/unclaim).
  "ratelimits": [
    { "name": "CLAIM_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }
  ]
  // Secrets (never in this file):
  //   wrangler secret put CLAIM_SECRET   -- same value as AUTOMONS_CLAIM_SECRET
  //   wrangler secret put ADMIN_TOKEN    -- for POST /admin/unclaim
}
